{
  "ai": {
    "provider": "deepseek",
    "deepseek": {
      "api_key": "在這裡填入你的 DeepSeek API key",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-chat"
    }
  },
  "stt": {
    "model_size": "large-v3",
    "device": "cuda",
    "compute_type": "int8_float16"
  },
  "hotkey": {
    "type": "keyboard",
    "key": "f9"
  },
  "replay_hotkey": {
    "type": "keyboard",
    "key": ""
  },
  "output": {
    "auto_copy": false,
    "tts_enabled": true,
    "tts_device": "default",
    "tts_rate": 200
  },
  "recording": {
    "device": "default",
    "isolate_other_devices": true
  },
  "subtitle": {
    "duration_seconds": 10,
    "font_size": 21,
    "opacity": 100,
    "bg_color": "#121212",
    "font_color": "#ffffff",
    "font_weight": "bold",
    "font_family": ""
  },
  "float_input": {
    "enabled": false,
    "opacity": 100
  },
  "ui": {
    "theme": "auto",
    "theme_color": "#0078d4",
    "auto_bubble": true
  }
}